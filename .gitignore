# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# harness
.env.local
harness/*.json
harness/published-links.md
harness/snapshots/
harness/thumbs/
harness/writes.log
harness/backups/
harness/uploads/
harness/render-tmp/
harness/*.jsonl

# studio: made by setup.sh and by the films themselves
studio/assets/
studio/.venv/
__pycache__/
